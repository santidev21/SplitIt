{
  "name": "split-it-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "node scripts/set-env.js",
    "prebuild": "node scripts/set-env.js",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false --browsers ChromeHeadlessNoSandbox",
    "test:coverage": "ng test --watch=false --browsers ChromeHeadlessNoSandbox --code-coverage",
    "test:ci": "ng test --watch=false --browsers ChromeHeadlessNoSandbox --code-coverage --karma-config karma.conf.js",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:https": "playwright test e2e/fullstack/docker-https-fullstack.spec.ts",
    "e2e:fullstack": "playwright test --config playwright.fullstack.config.ts",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.4",
    "@angular/cdk": "^22.2.5",
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/material": "^22.2.5",
    "@angular/platform-browser": "^22.2.4",
    "@angular/platform-browser-dynamic": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@ngx-translate/core": "^18.1.0",
    "@ngx-translate/http-loader": "^18.1.0",
    "bootstrap": "^5.3.8",
    "rxjs": "~7.8.0",
    "sweetalert2": "^11.26.25",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/jasmine": "~5.1.15",
    "@types/node": "^22.20.5",
    "angular-eslint": "22.6.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "http-server": "^14.1.1",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.13.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.3.0",
    "prettier": "^3.9.10",
    "serve": "^14.2.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
