<Project>

  <!--
    Shared Roslyn analyzer settings for the SplitIt backend.

    Ratchet strategy: analyzers run as WARNINGS for now, so the build stays green
    on the existing (legacy) codebase while still surfacing issues. Promote
    individual rules to `error` in .editorconfig as the code gets cleaned up.
    Do NOT add <TreatWarningsAsErrors>true</TreatWarningsAsErrors> here until the
    warning backlog is close to zero.
  -->
  <PropertyGroup>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" PrivateAssets="all" />
  </ItemGroup>

  <!-- Test projects: xUnit naming conventions intentionally use underscores. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <NoWarn>$(NoWarn);CA1707;CA1861;CA1822</NoWarn>
  </PropertyGroup>

</Project>
