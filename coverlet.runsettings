<?xml version="1.0" encoding="utf-8" ?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura,lcov,opencover</Format>
          <Exclude>[*.Tests]*,[SplitIt.Shared]*</Exclude>
          <ExcludeByAttribute>Obsolete,GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
          <!--
            EF Core migration scaffolding is auto-generated and applied verbatim by
            the integration-test fixture (DatabaseFixture), so coverlet reports it
            as ~100% covered and it dominates the denominator (it used to be ~89%
            of all coverable lines, inflating this gate to ~97%). Exclude only the
            generated Designer/snapshot files; migration Up/Down logic stays in
            scope. Mirrors sonar.coverage.exclusions in .github/workflows/sonarcloud.yml.
          -->
          <ExcludeByFile>**/Migrations/*.Designer.cs,**/Migrations/*ModelSnapshot.cs</ExcludeByFile>
          <Threshold>70</Threshold>
          <ThresholdType>line</ThresholdType>
          <ThresholdStat>total</ThresholdStat>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
