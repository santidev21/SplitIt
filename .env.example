# SplitIt — Environment Template
# Copy to .env and fill with real secrets (NEVER commit .env)
# Generate JWT secret: openssl rand -base64 64   (Linux/macOS)  or  [Convert]::ToBase64String((1..64|%{Get-Random -Max 256})) in PowerShell

# === Backend ===
ConnectionStrings__DefaultConnection=Server=sqlserver,1433;Database=SplitItDB;User Id=sa;Password=CHANGE_ME_STRONG_32CHARS;TrustServerCertificate=True;
JwtSettings__SecretKey=CHANGE_ME_64_CHARS_RANDOM_BASE64
JwtSettings__Issuer=https://api.yourdomain.com
JwtSettings__Audience=https://api.yourdomain.com
JwtSettings__ExpirationInMinutes=60
Cors__AllowedOrigins=https://yourdomain.com

# === SQL Server ===
MSSQL_SA_PASSWORD=CHANGE_ME_STRONG_32CHARS
MSSQL_DATABASE=SplitItDB

# === Frontend (build-time) ===
# For Angular, apiUrl is baked at build. Set via environment.prod.ts or NG_APP_API_URL
NG_APP_API_URL=https://api.yourdomain.com/api
