# SplitIt — Docker & Environment Variables Template
# Copy this file to '.env' and fill with strong, unique secrets. NEVER commit '.env' to git!
# Generate JWT secret: openssl rand -base64 64  (or PowerShell: [Convert]::ToBase64String((1..64|%{Get-Random -Max 256})))

# === Public domain / TLS ===
# Production domain that Nginx will use for HTTPS and ACME HTTP-01 challenge.
DOMAIN=splitit.yourdomain.com

# TLS mode: 'letsencrypt' for production, 'selfsigned' for local HTTPS testing only.
TLS_MODE=letsencrypt

# ACME contact email for Let's Encrypt expiry/ToS notifications.
ACME_EMAIL=admin@yourdomain.com

# Host ports published by the reverse proxy (the ONLY exposed services).
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443

# === SQL Server Database Security ===
# SA (System Administrator) — used ONLY for initial DB creation and app user provisioning via db-init container.
# Never used by the API at runtime. Minimum 8 chars, uppercase, lowercase, numbers, symbols.
DB_PASSWORD=CHANGE_ME_STRONG_SA_PASSWORD_32CHARS_MIN!

# Dedicated least-privilege application user — API runtime, NOT sa.
# Roles: db_datareader + db_datawriter ONLY (no DDL) — NOT db_owner.
# Must be different from SA password in production.
DB_APP_USER=splitit_app
DB_APP_PASSWORD=CHANGE_ME_STRONG_APP_PASSWORD_32CHARS_MIN!

# Migration user — used ONLY by one-shot migrator container to apply EF Core migrations.
# Roles: db_datareader + db_datawriter + db_ddladmin (schema changes), NOT db_owner.
# Must be different from SA and APP passwords in production.
DB_MIGRATOR_USER=splitit_migrator
DB_MIGRATOR_PASSWORD=CHANGE_ME_STRONG_MIGRATOR_PASSWORD_32CHARS_MIN!

# === JWT Authentication Hardening ===
# Minimum 64 characters long random string
JWT_SECRET=CHANGE_ME_MINIMUM_64_CHARACTERS_LONG_RANDOM_SECRET_KEY_FOR_PRODUCTION_JWT!!
JWT_ISSUER=https://splitit.yourdomain.com
JWT_AUDIENCE=https://splitit.yourdomain.com

# === CORS & Frontend Security ===
# Production: exactly one origin — the public HTTPS domain. Fail-closed if missing.
CORS_ALLOWED_ORIGINS=https://splitit.yourdomain.com
